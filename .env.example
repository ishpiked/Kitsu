# Bot Configuration
BOT_TOKEN=your_bot_token_here

# Database Configuration (Neon PostgreSQL)
# Format: postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/anilist_bot?sslmode=require

# Redis Configuration (Upstash HTTP Redis for serverless)
# Format: redis://default:password@us1-bird-12345.upstash.io:6379
# Or Upstash REST: https://us1-bird-12345.upstash.io (with UPSTASH_REDIS_REST_TOKEN)
REDIS_URL=redis://default:password@us1-bird-12345.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://us1-bird-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# AniList OAuth Configuration
ANILIST_CLIENT_ID=your_client_id_here
ANILIST_CLIENT_SECRET=your_client_secret_here
ANILIST_REDIRECT_URI=https://your-app.vercel.app/api/auth/anilist/callback

# Webhook Configuration (Production)
WEBHOOK_URL=https://your-app.vercel.app

# Application Configuration
ENVIRONMENT=production
LOG_LEVEL=INFO

# Prevent Python bytecode compilation (required for Vercel)
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1