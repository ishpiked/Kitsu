{
  "version": 2,
  "buildCommand": "pip install -r requirements.txt",
  "devCommand": "python run.py",
  "installCommand": "pip install -r requirements.txt",
  "framework": null,
  "builds": [
    {
      "src": "app/server.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "app/server.py"
    },
    {
      "src": "/webhook",
      "dest": "app/server.py"
    },
    {
      "src": "/health",
      "dest": "app/server.py"
    },
    {
      "src": "/(.*)",
      "dest": "app/server.py"
    }
  ],
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1",
    "BOT_TOKEN": "@bot_token",
    "DATABASE_URL": "@database_url",
    "REDIS_URL": "@redis_url",
    "ANILIST_CLIENT_ID": "@anilist_client_id",
    "ANILIST_CLIENT_SECRET": "@anilist_client_secret",
    "ANILIST_REDIRECT_URI": "@anilist_redirect_uri",
    "WEBHOOK_URL": "@webhook_url",
    "ENVIRONMENT": "production",
    "LOG_LEVEL": "INFO"
  }
}